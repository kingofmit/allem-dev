{
  "name": "allem-dev",
  "version": "0.2.0",
  "description": "The floating dev panel for React. One import, zero config. Cmd+Shift+D to toggle.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@allem-dev/core": "workspace:*",
    "@allem-dev/errors": "workspace:*",
    "@allem-dev/network": "workspace:*",
    "@allem-dev/perf": "workspace:*",
    "@allem-dev/renders": "workspace:*",
    "@allem-dev/state": "workspace:*",
    "lucide-react": "^1.73.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/allem-dev.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/kingofmit/allem-dev",
  "keywords": [
    "react",
    "devtools",
    "dev-panel",
    "debugging",
    "network",
    "performance",
    "profiler",
    "state",
    "errors"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
