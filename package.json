{
  "name": "allem-dev",
  "version": "0.0.0",
  "private": true,
  "description": "The floating dev panel for React — API inspector, re-render tracker, state timeline, performance profiler, and error catcher. One import, zero config.",
  "author": "Ahmed Allem",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kingofmit/allem-dev.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  }
}
